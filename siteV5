    <style>
      /* ======= REGRAS GERAIS ======= */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: Arial, sans-serif;
      }

      body {
        width: 100%;
        overflow-x: hidden; /* Evita scroll lateral */
      }

      /* ======= CABEÇALHO ======= */
      header {
        position: fixed;
        z-index: 99;
        display: flex;
        width: 100%;
        justify-content: space-between;
        align-items: center;
        padding: 2vh 5vw;
        background: #fff;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
      }

      header img {
        height: 8vh;
        max-height: 60px;
      }

      nav ul {
        list-style: none;
        display: flex;
        gap: 25px;
      }

      nav ul li a {
        text-decoration: none;
        color: #000;
        font-weight: bold;
      }

      nav ul li a:hover {
        color: #0077b6;
      }

      /* ======= BOTÃO HAMBÚRGUER ======= */
      .menu-toggle {
        display: none; /* Escondido por padrão em telas grandes */
        flex-direction: column;
        cursor: pointer;
        gap: 5px;
      }

      .menu-toggle span {
        display: block;
        height: 3px;
        width: 30px;
        background: #000;
        border-radius: 2px;
        transition: 0.3s;
      }

      /* ======= BANNER ======= */
      .banner {
        position: relative;
        background-color: gray;
        /* Exemplo com imagem de fundo:*/
      background: url(./vecteezy_construction-tools-and-plans-on-a-blue-background-featuring_51699132.jpeg) no-repeat center center/cover;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        color: #fff;
      }

      .conteudo-banner {
        background: rgba(0, 47, 108, 0.8);
        padding: 4vw;
        width: 50vw;
        height: auto;
        margin-left: 5vw;
        border-radius: 8px;
      }

      .conteudo-banner h1 {
        font-size: 2.2vw;
        margin-bottom: 10px;
      }

      .conteudo-banner p {
        font-size: 1.5vw;
        margin-bottom: 20px;
      }

      .botao {
        display: inline-block;
        background: #f8e47a;
        color: #000;
        font-weight: bold;
        width: 50%;
        min-width: 200px;
        font-size: 1.5vw;
        padding: 3vh 2vw;
        margin-top: 8vh;
        border-radius: 25px;
        text-decoration: none;
        text-align: center;
        transition: background 0.3s;
      }

      .botao:hover {
        background: #ffc107;
      }

      /* ======= SEÇÃO SOBRE NÓS ======= */
      .sobre {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 6vw;
        max-width: 90vw;
        margin: 8vh auto;
        padding: 0 20px;
      }

      .sobre .texto {
        flex: 2;
        margin-top: 40px;
      }

      .sobre h2 {
        background-color: #6b7bbf;
        color: white;
        font-size: 18px;
        width: fit-content;
        padding: 0.5vw 1vw;
        font-weight: bold;
        margin-bottom: 20px;
      }

      .sobre p {
        font-size: 18px;
        line-height: 1.6;
        color: #333;
        text-align: justify;
      }

      .sobre .imagem {
        flex: 1;
        display: flex;
        justify-content: center;
      }

      .sobre .imagem img {

        width: 100%;
        max-width: 500px;
        height: 700px;
        border-radius: 6px;
        object-fit: cover;
        background-color: gray;
      }

      /* ======= SEÇÃO VISÃO E MISSÃO ======= */
      .visao-missao {
        background: #6b7bbf;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 30vw;
        padding: 10vh 5vw;
        color: white;
      }

      .visao-missao .bloco {
        text-align: center;
      }

      .visao-missao h3 {
        font-size: 28px;
        font-weight: bold;
        margin-bottom: 20px;
      }

      .visao-missao .logo {
        width: 120px;
        height: 120px;
        background: gray;
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 0 auto 20px auto;
        font-weight: bold;
        font-size: 12px;
        color: black;
      }

      .visao-missao p {
        font-size: 16px;
        color: white;
      }
      /* Ajustes para tablet */
@media (max-width: 1024px) {
  .visao-missao {
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 30px;
  }

  .visao-missao .bloco {
    max-width: 600px; /* limita largura pra não ficar gigante */
  }
}

/* Ajustes para celular */
@media (max-width: 768px) {
  .visao-missao {
    flex-direction: column;
    gap: 20px;
  }

  .visao-missao .bloco {
    width: 100%;
    padding: 10px;
    text-align: center;
  }
  

  .visao-missao h3 {
    font-size: 20px;
    margin-bottom: 10px;
  }

  .visao-missao p {
    font-size: 16px;
    line-height: 1.4;
  }

  .visao-missao .logo {
    margin: 0px auto;
    width: 60px;
    height: 60px; /
  }

}

      /* ======= SEÇÃO VALORES ======= */
      .valores {
        background: gray;
        text-align: center;
        padding: 8vh 5vw;
        height: auto;
        color: #f8e47a;
      }

      .valores h2 {
        font-size: 2vw;
        font-weight: bold;
        margin-top: 20px;
        margin-bottom: 40px;
        line-height: 1.4;
      }

      .valores-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 3vh 6vw;
        justify-items: center;
        max-width: 800px;
        margin: 0 auto;
      }

      .valor {
        display: flex;
        align-items: center;
        gap: 15px;
        font-weight: bold;
        font-size: 1.5vw;
        color: #f8e47a;
      }

      .quadrado {
        width: 55px;
        height: 55px;
        background: black;
        border: 2px solid #f8e47a;
        border-radius: 6px;
      }

      /* ======= SEÇÃO PORTFÓLIO (CARROSSEL) ======= */
      .carrossel {
        position: relative;
        margin: 0 auto;
        overflow: hidden;
        display: flex;
        align-items: center;
        padding: 0 0 50px 0;
      }

      .pista-carrossel {
        display: flex;
        transition: transform 0.5s ease-in-out;
      }

      .item-carrossel {
        background: gray;
        border: 5px solid white;
        display: flex;
        justify-content: center;
        align-items: center;
        min-width: 25vw;
        height: 55vh;
        font-size: 2vw;
      }

      .botao-carrossel {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: #f8e47a;
        border: 1px solid black;
        border-radius: 15px;
        cursor: pointer;
        padding: 2vh 2vw;
        z-index: 2;
      }

      .botao-carrossel.anterior {
        left: 10px;
      }

      .botao-carrossel.proximo {
        right: 10px;
      }
      /* Tablet: 2 blocos inteiros */
@media (max-width: 1024px) {
    .item-carrossel {
        min-width: 80%;   /* 2 blocos certinhos */
        font-size: 4vw;
    }
}

/* Celular: 1 bloco e meio */
@media (max-width: 768px) {
    .item-carrossel {
        min-width: 80%;   /* 1 bloco cheio + pedaço do próximo */
        font-size: 23vw;
    }
}
      

      /* ======= SERVIÇOS (CARROSSEL) ======= */
      .carrossel-servicos {
        position: relative;
        margin: 0 auto;
        overflow: hidden;
        display: flex;
        align-items: center;
        padding: 0 0 50px 0;
      }

      .pista-servicos {
        display: flex;
        transition: transform 0.5s ease-in-out;
      }

      .item-servicos {
        background: gray;
        border: 5px solid white;
        display: flex;
        justify-content: center;
        align-items: center;
        min-width: 25vw;
        height: 55vh;
        font-size: 2vw;
      }

      .botao-servicos {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: #f8e47a;
        border: 1px solid black;
        border-radius: 15px;
        cursor: pointer;
        padding: 2vh 2vw;
        z-index: 2;
      }

      .botao-servicos.anterior {
        left: 10px;
      }

      .botao-servicos.proximo {
        right: 10px;
      }

      .titulo-secao-caixa {
        width: 100%;
        height: 35vh;
        background-color: black;
        display: flex;
        justify-content: center;
        align-items: center;
        color: white;
      }

      .titulo-secao-caixa h2 {
        font-size: 48px;
        margin: 0;
      }
      /* ======= RESPONSIVIDADE ======= */

/* Tablet: 2 blocos inteiros */
@media (max-width: 1024px) {
    .item-servicos {
        min-width: 50%;   /* 2 blocos certinhos */
        font-size: 3vw;
    }
}

/* Celular: 1 bloco e meio */
@media (max-width: 768px) {
    .item-servicos {
        min-width: 80%;   /* 1 bloco cheio + pedaço do próximo */
        font-size: 4vw;
    }
}

      /* ======= SEÇÃO PARCEIROS ======= */
      .parceiros {
        text-align: center;
        padding: 40px 20px;
      }

      .parceiros h2 {
        height: 25vh;
        font-weight: bold;
      }

      .parceiros .logos {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 15vw;
      }

      .parceiros .logo {
        width: 300px;
        height: 250px;
        background-color: gray;
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 12px;
      }

      /* ======= RODAPÉ ======= */
      .rodape {
        background: #0c1220;
        color: white;
        display: flex;
        justify-content: space-around;
        align-items: flex-start;
        padding: 6vh 5vw;
        flex-wrap: wrap;
      }

      .rodape .coluna {
        flex: 1;
        min-width: 200px;
        margin: 10px 20px;
      }

      .rodape h3 {
        font-size: 1.5vw;
        margin-bottom: 15px;
      }

      .rodape ul {
        list-style: none;
        padding: 0;
      }

      .rodape ul li {
        margin: 5px 0;
      }

      .rodape a {
        color: #fff;
        text-decoration: none;
      }

      .rodape a:hover {
        text-decoration: underline;
      }

      .rodape form {
        margin-top: 3vh;
      }

      .rodape form input {
        padding: 1vh;
        margin: 5px 0;
        width: 100%;
        border: none;
        border-radius: 4px;
      }

      .rodape form button {
        padding: 1vh 2vw;
        background: #f8e47a;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        margin-top: 8px;
      }

      .rodape form button:hover {
        background: #ffc107;
      }

      .mapa {
        width: 35vw;
        height: 30vh;
        background: white;
        color: black;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      /* ======= ANIMAÇÕES ======= */
      .animado {
        opacity: 0;
        transition: all 1.5s ease;
      }

      /* Vem da esquerda */
      .animado.esquerda {
        transform: translateX(-80px);
      }
      .animado.esquerda.aparecer {
        opacity: 1;
        transform: translateX(0);
      }

      /* Vem da direita */
      .animado.direita {
        transform: translateX(80px);
      }
      .animado.direita.aparecer {
        opacity: 1;
        transform: translateX(0);
      }

      /* Vem de baixo */
      .animado.baixo {
        transform: translateY(80px);
      }
      .animado.baixo.aparecer {
        opacity: 1;
        transform: translateY(0);
      }

      /* Vem de cima */
      .animado.cima {
        transform: translateY(-80px);
      }
      .animado.cima.aparecer {
        opacity: 1;
        transform: translateY(0);
      }

      /* ======= RESPONSIVIDADE ======= */

      /* Telas até 1024px (notebooks menores e tablets em horizontal) */
      @media (max-width: 1024px) {
        header {
          padding: 15px 25px;
        }

        .conteudo-banner {
          width: 80%;
          height: auto;
          margin-left: 20px;
        }

        .sobre {
          gap: 40px;
        }

        .valores {
          height: auto;
        }
      }

      /* Telas até 768px (tablets e celulares grandes) */
      @media (max-width: 768px) {
        /* Estilos do menu mobile */
        .menu-toggle {
          display: flex; /* Mostra o botão hambúrguer */
        }

        nav {
          display: none; /* Esconde o menu de navegação */
          position: absolute;
          top: 80px; /* Ajuste conforme a altura do header */
          right: 0;
          background: #fff;
          width: 100%;
          box-shadow: 0 5px 10px rgba(0, 0, 0, 0.1);
        }

        nav.ativo {
          display: block; /* Mostra o menu quando ativo */
          animation: slideDown 0.3s ease forwards;
        }

        nav ul {
          flex-direction: column;
          gap: 15px;
          padding: 20px;
          align-items: center;
        }

        @keyframes slideDown {
          from {
            opacity: 0;
            transform: translateY(-10px);
          }
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }

        /* Outros ajustes responsivos */
        .banner {
          height: auto;
          padding: 120px 0 40px 0;
          justify-content: center;
          text-align: center;
        }

        .conteudo-banner {
          margin: 0;
          width: 90%;
          height: auto;
        }

        .conteudo-banner h1,
        .conteudo-banner p,
        .botao {
          font-size: initial; /* Reseta para o padrão do navegador */
        }

        .conteudo-banner h1 {
          font-size: 22px;
        }

        .conteudo-banner p {
          font-size: 14px;
        }

        .botao {
          width: 100%;
          font-size: 16px;
          margin-top: 30px;
          padding: 18px;
        }

        .sobre {
          flex-direction: column;
          align-items: center;
          text-align: center;
        }

        .sobre .imagem img {
          height: auto;
          max-height: 400px;
        }

        .valores h2 {
          font-size: 20px;
        }
        .valor {
          font-size: 18px;
        }

        .valores-grid {
          grid-template-columns: 1fr;
          gap: 20px;
        }
        /* Layout padrão (desktop) já funciona, não mexa */

        /* Tablets */
        @media (max-width: 1024px) {
        .valores-grid {
            display: grid;
            grid-template-columns: 1fr 1fr; /* dois valores por linha */
            gap: 20px;
            text-align: center;
        }

        .valor {
            justify-content: center;
        }

        .quadrado {
            margin: 0 auto 10px auto;
        }
        }
        
        /* responsivo dos quadrado no cell e tablet*/
        @media (max-width: 768px) {
        .valores-grid {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .valor {
            display: flex;
            align-items: center;
            gap: 8px; /* espaço entre quadrado e texto */
        }

        .valores-grid .valor:nth-child(odd) {
            margin-right: auto;
        }

        .valores-grid .valor:nth-child(even) {
            margin-left: auto;
            flex-direction: row-reverse; /* inverte: texto antes, quadrado depois */
        }
        }

        .parceiros .logos {
          flex-direction: column;
          gap: 40px;
        }

        .rodape {
          flex-direction: column;
          align-items: center;
          text-align: center;
        }

        .rodape .coluna {
          margin: 20px 0;
          min-width: 100%;
        }

        .mapa {
          width: 100%;
          max-width: 400px;
        }

        .visao-missao {
          flex-direction: column;
          gap: 40px;
        }
      }

      /* Telas até 480px (celulares pequenos) */
      @media (max-width: 480px) {
        .conteudo-banner {
          padding: 20px;
        }

        .conteudo-banner h1 {
          font-size: 18px;
        }

        .conteudo-banner p {
          font-size: 13px;
        }

        .botao {
          font-size: 14px;
          padding: 15px;
        }

        .sobre h2 {
          font-size: 14px;
          width: auto;
          padding: 8px;
        }

        .valores h2 {
          font-size: 18px;
        }

        .valor {
          font-size: 16px;
        }

        .titulo-secao-caixa h2 {
          font-size: 28px;
        }

        .parceiros h2 {
          font-size: 22px;
        }

        .parceiros .logo {
          width: 200px;
          height: 150px;
          font-size: 10px;
        }
      }
    </style>
