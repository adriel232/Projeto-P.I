        <div class="mapa">Mapa</div>
      </div>
    </footer>

    <script>
      // MENU HAMBÚRGUER
      const menuToggle = document.getElementById("menu-toggle");
      const menu = document.getElementById("menu");

      menuToggle.addEventListener("click", () => {
        menu.classList.toggle("ativo");
      });

      // ======= CARROSSEL PORTFÓLIO =======
      const pista = document.querySelector(".pista-carrossel");
      const itens = Array.from(pista.children);
      const botaoAnterior = document.querySelector(".botao-carrossel.anterior");
      const botaoProximo = document.querySelector(".botao-carrossel.proximo");
      const container = document.querySelector(".carrossel");
      const larguraItem =
        itens.length > 0 ? itens[0].getBoundingClientRect().width : 0;

      let posicaoAtual = 0;

      botaoProximo.addEventListener("click", () => {
        const maxScroll = pista.scrollWidth - container.clientWidth;
        posicaoAtual += larguraItem;
        if (posicaoAtual > maxScroll) {
          posicaoAtual = maxScroll;
        }
        pista.style.transform = `translateX(-${posicaoAtual}px)`;
      });

      botaoAnterior.addEventListener("click", () => {
        posicaoAtual -= larguraItem;
        if (posicaoAtual < 0) {
          posicaoAtual = 0;
        }
        pista.style.transform = `translateX(-${posicaoAtual}px)`;
      });

      // ======= CARROSSEL SERVIÇOS =======
      const pistaServicos = document.querySelector(".pista-servicos");
      const itensServicos = Array.from(pistaServicos.children);
      const botaoAnteriorServicos = document.querySelector(
        ".botao-servicos.anterior"
      );
      const botaoProximoServicos = document.querySelector(
        ".botao-servicos.proximo"
      );
      const containerServicos = document.querySelector(".carrossel-servicos");
      const larguraItemServicos =
        itensServicos.length > 0
          ? itensServicos[0].getBoundingClientRect().width
          : 0;

      let posicaoAtualServicos = 0;

      botaoProximoServicos.addEventListener("click", () => {
        const maxScrollServicos =
          pistaServicos.scrollWidth - containerServicos.clientWidth;
        posicaoAtualServicos += larguraItemServicos;
        if (posicaoAtualServicos > maxScrollServicos) {
          posicaoAtualServicos = maxScrollServicos;
        }
        pistaServicos.style.transform = `translateX(-${posicaoAtualServicos}px)`;
      });

      botaoAnteriorServicos.addEventListener("click", () => {
        posicaoAtualServicos -= larguraItemServicos;
        if (posicaoAtualServicos < 0) {
          posicaoAtualServicos = 0;
        }
        pistaServicos.style.transform = `translateX(-${posicaoAtualServicos}px)`;
      });

      // ======= ANIMAÇÕES COM INTERSECTION OBSERVER =======
      const elementosAnimados = document.querySelectorAll(".animado");

      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("aparecer");
                obs.unobserve(entry.target); // anima só uma vez
              }
            });
          },
          {
            root: null,
            rootMargin: "0px",
            threshold: 0.15, // quando 15% do elemento estiver visível
          }
        );

        elementosAnimados.forEach((el) => observer.observe(el));
      } else {
        // Fallback para navegadores antigos: usa o método de scroll
        function animarAoScrollFallback() {
          const alturaTela = window.innerHeight * 0.8;
          elementosAnimados.forEach((el) => {
            const topoElemento = el.getBoundingClientRect().top;
            if (topoElemento < alturaTela) {
              el.classList.add("aparecer");
            }
          });
        }

        window.addEventListener("scroll", animarAoScrollFallback);
        window.addEventListener("load", animarAoScrollFallback);
      }
    </script>
  </body>
</html>
